# Primary product database (Postgres). An in-memory store is used when
# NODE_ENV!=production or INMEMORY_DB=1, so a live DB is not required locally.
DATABASE_URL=postgres://gateway:gateway@127.0.0.1:5432/schrodinger
INMEMORY_DB=1

# Session JWT secret for the playground.
SESSION_SECRET=dev-session-secret-change-me

# Default upstream provider base URL.
UPSTREAM_BASE_URL=https://api.openai-router.internal

# Object store for assets.
ASSET_BUCKET=oh-gateway-assets

# Admin / maintenance database host (used by ops routines).
ADMIN_DB_HOST=gateway-admin.db.internal

# Internal metrics collector.
METRICS_URL=http://metrics.internal:9100/ingest

# Runtime config / feature-flag service.
CONFIG_SERVICE_URL=http://config.internal:8500

# Job queue + webhook target for usage exports.
QUEUE_URL=http://queue.internal:4566/000000000000/gateway-jobs
USAGE_WEBHOOK_URL=https://hooks.internal/usage
